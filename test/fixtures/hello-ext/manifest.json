{
  "manifest_version": 3,
  "name": "Opal Test Extension",
  "version": "1.0.0",
  "description": "Marks pages and has a popup, for Opal's tests.",
  "action": { "default_popup": "popup.html", "default_title": "Opal test" },
  "background": { "service_worker": "bg.js" },
  "permissions": ["contextMenus", "storage", "tabs"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" }]
}
